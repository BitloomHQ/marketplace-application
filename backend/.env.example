# Copy to backend/.env and fill in real values.
# Loaded by backend/backend/settings.py (required unless noted).

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — use DATABASE_URL on Render/Neon (preferred)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Or separate vars for local PostgreSQL
DB_NAME=home_services_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Redis (Django Channels / WebSockets)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional — server-side only; never expose as VITE_* in the frontend.
GOOGLE_MAPS_API_KEY=

# Email (Resend)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Marketplace <onboarding@resend.dev>

# S3-compatible storage (AWS S3 or Supabase Storage)
# Leave AWS_STORAGE_BUCKET_NAME empty for local disk storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Supabase example:
# AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
# AWS_S3_PUBLIC_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/YOUR_BUCKET
#
# AWS S3 example (leave endpoint/public base empty):
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=ap-south-1

AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_BASE_URL=
